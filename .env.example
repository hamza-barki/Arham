# ==============================================================================
# ENVIRONMENT VARIABLES FOR [BRAND_NAME] E-COMMERCE PLATFORM
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Configuration (PostgreSQL Database & Authentication)
# ------------------------------------------------------------------------------
# Get these from your Supabase Dashboard: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# CRITICAL SECURITY: Never expose SUPABASE_SERVICE_ROLE_KEY to the browser / client side.
# This key bypasses Row Level Security (RLS) and is strictly used in Server Actions,
# Route Handlers, and admin sync processes.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key-here

# ------------------------------------------------------------------------------
# 2. Cloudinary Configuration (Image Uploads & Media Delivery)
# ------------------------------------------------------------------------------
# Found in Cloudinary Console: Dashboard -> API Keys & Environment variable
# CLOUDINARY_URL format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=cloudinary://123456789012345:abcdefghijklmnopqrstuvw_xyz@your-cloud-name

# Individual credentials for client/server convenience:
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=abcdefghijklmnopqrstuvw_xyz

# ------------------------------------------------------------------------------
# 3. Store Brand & Pakistani Market Configuration
# ------------------------------------------------------------------------------
# Public brand name displayed across header, title tags, and notifications
NEXT_PUBLIC_BRAND_NAME="[BRAND_NAME]"

# Base URL of your deployed application (used for SEO metadata and redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Default Currency & Delivery charges in PKR
NEXT_PUBLIC_CURRENCY_SYMBOL="Rs."
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD="3000"
NEXT_PUBLIC_STANDARD_SHIPPING_FEE="200"

# Pakistan Customer Support Hotline / WhatsApp (for COD queries)
NEXT_PUBLIC_WHATSAPP_NUMBER="+923001234567"
NEXT_PUBLIC_SUPPORT_EMAIL="support@brandname.pk"
